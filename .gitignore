# Local plans (not tracked)
/plans/

# Claude Code config and sandbox-injected files (shell/editor configs mounted
# into the working tree). They must match in any directory an agent is
# started from. A middle slash anchors a pattern, so keep the `**/` prefix.
# Mounts can be files or directories, so do not add a trailing slash.
# Un-ignore specific paths where needed.
**/.claude/*
!/.claude/settings.json
!/.claude/skills/
.mcp.json
.bash_profile
.bashrc
.gitconfig
.gitmodules
.profile
.ripgreprc
.zprofile
.zshrc
.idea
.vscode

# Editors
*.swp
*~

# OS
.DS_Store
Thumbs.db
