{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    extends: [
        // config:recommended, plus docker:pinDigests, helpers:pinGitHubActionDigests,
        // :configMigration, :pinDevDependencies, abandonments:recommended,
        // security:minimumReleaseAgeNpm and :maintainLockFilesWeekly.
        // Renovate's own docs recommend this over plain config:recommended.
        // NOTE: :pinDevDependencies pins devDependencies in package.json to exact
        // versions, replacing the `^x.y.z` ranges we have today.
        "config:best-practices",
        // Track SHA-pinned actions by the `# vX.Y.Z` comment as semver, rather than
        // by digest movement on a floating tag.
        "helpers:pinGitHubActionDigestsToSemver",
        // The pre-commit manager is disabled by default in renovate, so opt in
        // explicitly.
        ":enablePreCommit",
        // config:recommended would use fix(deps) for runtime dependencies.
        // Everything in this repo's history is chore(deps) — keep it uniform.
        ":semanticCommitTypeAll(chore)",
    ],
    timezone: "Europe/Oslo",
    // Roughly matches the weekly interval in .github/dependabot.yml.
    schedule: ["* 2-6 * * 1"],
    // Parity with the 7-day cooldown in .github/dependabot.yml — and required, not
    // cosmetic: pnpm-workspace.yaml sets `minimumReleaseAge: 10080` (7 days), and
    // pnpm honours that when renovate shells out to it to regenerate
    // pnpm-lock.yaml. Without a matching floor here renovate proposes versions its
    // own lockfile step then fails to resolve.
    minimumReleaseAge: "7 days",
    prConcurrentLimit: 5,
    prHourlyLimit: 2,
    // Keep this off until the default branch ruleset requires status checks.
    // With no required check, platform automerge can merge a red PR.
    automerge: false,
    packageRules: [
        {
            // A digest-only move on a SHA-pinned action means an existing tag was
            // repointed upstream — the tag-hijack signature
            // (tj-actions/changed-files, CVE-2025-30066). Legitimate fixes arrive
            // as a new tag through the normal version-update path.
            matchManagers: ["github-actions"],
            matchUpdateTypes: ["digest"],
            enabled: false,
        },
        {
            // Renovate cannot date this image, so the repo-level
            // minimumReleaseAge never clears for it. The tag's OCI index carries
            // no annotations, and the only timestamp is `created` in the image
            // config blob, behind a signed redirect to a storage host. The
            // v1.62.1-noble image was built 2026-07-30, and renovate still
            // reported `renovate/stability-days` as pending on it on 2026-08-20
            // (#364) — an unknown age counts as an unmet one, indefinitely.
            matchDatasources: ["docker"],
            matchPackageNames: ["mcr.microsoft.com/playwright"],
            minimumReleaseAge: null,
        },
        {
            // playwright is pinned in two files that must agree on the chromium
            // browser revision: `playwright` in package.json, and the ui-tests
            // container tag in .github/workflows/testing.yml. Group them so one
            // PR moves both. Must be LAST — later rules override earlier ones
            // field-by-field, so a broader rule added below would clobber this
            // groupName.
            //
            // Grouped is not atomic. The two resolve from independent sources
            // (npm and a container registry) and renovate drops any half that
            // has not cleared its checks, so a run can produce a PR that moves
            // only one file. Expect that for up to a week after each playwright
            // release — the image is exempt above while the npm half still waits
            // out minimumReleaseAge — with ui-tests red until the second half
            // lands. `dependencyDashboardApproval: true` here would trade that
            // window for a checkbox tick per release.
            matchDatasources: ["npm", "docker"],
            matchPackageNames: ["playwright", "mcr.microsoft.com/playwright"],
            groupName: "playwright",
        },
    ],
}
