{
    "name": "rainbow",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "imports": {
        "#*": "./src/*"
    },
    "scripts": {
        "dev:staging": "vite --mode proxy-staging",
        "dev:production": "vite --mode proxy-production",
        "tsc": "tsc -p tsconfig.app.json",
        "tsc:watch": "tsc -w -p tsconfig.app.json",
        "tsc:node": "tsc -p tsconfig.node.json",
        "vite:build": "vite build",
        "build": "run-p tsc vite:build",
        "oxfmt:check": "oxfmt --check",
        "oxfmt:write": "oxfmt",
        "oxlint:check": "oxlint",
        "oxlint:write": "oxlint --fix",
        "lint:check": "run-p oxlint:check oxfmt:check",
        "lint:fix": "run-s oxfmt:write oxlint:write",
        "test": "vitest run --browser=chromium --browser.headless",
        "test:unit": "vitest run --project unit",
        "test:ui": "vitest run --project ui --browser=chromium --browser.headless",
        "test:ui:chromium": "vitest run --project ui --browser=chromium --browser.headless",
        "test:ui:webkit": "vitest run --project ui --browser=webkit --browser.headless",
        "test:ui:all": "vitest run --project ui --browser.headless",
        "test:watch": "vitest --browser=chromium",
        "test:watch:unit": "vitest --project unit",
        "test:watch:ui": "vitest --project ui --browser=chromium",
        "test:coverage": "vitest run --coverage --browser=chromium --browser.headless",
        "preview": "vite preview",
        "knip": "knip",
        "knip:fix": "knip --fix"
    },
    "dependencies": {
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@fontsource/roboto": "5.3.0",
        "@mui/icons-material": "9.5.0",
        "@mui/material": "9.5.0",
        "@mui/x-date-pickers": "9.17.0",
        "@sentry/react": "11.10.0",
        "@sentry/vite-plugin": "11.10.0",
        "@tanstack/react-query": "5.105.1",
        "@tanstack/react-query-persist-client": "5.105.1",
        "@tanstack/react-router": "1.170.46",
        "dayjs": "1.11.23",
        "html-to-image": "1.11.13",
        "idb-keyval": "6.3.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-window": "2.5.3",
        "recharts": "3.10.1",
        "ua-parser-js": "2.0.10",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@rolldown/plugin-babel": "0.3.0",
        "@tanstack/eslint-plugin-query": "5.105.1",
        "@tanstack/react-query-devtools": "5.105.1",
        "@tanstack/react-router-devtools": "1.167.2",
        "@tanstack/router-plugin": "1.168.48",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "@vitest/browser-playwright": "5.0.5",
        "@vitest/coverage-v8": "5.0.5",
        "babel-plugin-react-compiler": "1.0.0",
        "knip": "6.44.1",
        "msw": "3.0.3",
        "npm-run-all2": "9.0.4",
        "oxfmt": "0.75.0",
        "oxlint": "1.90.0",
        "oxlint-tsgolint": "7.0.2005",
        "playwright": "1.64.1",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vite-plugin-react-click-to-component": "4.2.3",
        "vitest": "5.0.5",
        "vitest-browser-react": "2.3.0",
        "wrangler": "4.157.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.13.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.17.0"
}
